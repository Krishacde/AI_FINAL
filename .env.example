# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Tool & Research API Keys
TAVILY_API_KEY=your_tavily_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Redis cache for repeated public research/weather/flight lookups.
# If Redis is unavailable, a bounded in-process cache is used instead.
REDIS_URL=redis://localhost:6379/0
# Durable trip snapshots, conversation messages, and itinerary versions (SQLite).
# Defaults to %LOCALAPPDATA%/TripMateAI/trips.sqlite3 on Windows.
# TRIPMATE_TRIPS_DB=./data/trips.sqlite3
TAVILY_CACHE_TTL_SECONDS=21600
FLIGHT_CACHE_TTL_SECONDS=120
WEATHER_CACHE_TTL_SECONDS=1800
GEOCODING_CACHE_TTL_SECONDS=2592000

# Simulated wallet and payment-policy amounts use paise (minor units).
SIMULATED_AGENT_WALLET_MINOR=10000000
SIMULATED_MAX_TRANSACTION_MINOR=10000000
SIMULATED_DAILY_LIMIT_MINOR=20000000
# Configurable base used by the local accommodation sandbox quote provider.
# These are test rates; they do not represent supplier inventory or live hotel prices.
SANDBOX_HOTEL_BASE_NIGHTLY_INR=4200
SANDBOX_HOTEL_RATE_SPREAD_PERCENT=18
# Optional dedicated PostgreSQL URL for the simulated ledger. Leave unset to use SQLite.
# SIMULATED_PAYMENT_DATABASE_URL=postgresql://user:password@localhost:5432/tripmate_payments
# Optional SQLite path override.
# SIMULATED_PAYMENT_DB=./payments.sqlite3
